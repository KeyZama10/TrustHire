# Copy to .env. All settings are optional.
TRUSTHIRE_PROFILE=cpu                 # cpu | gpu
# TRUSTHIRE_MODELS_DIR=~/.trusthire/models
# TRUSTHIRE_DATA_DIR=~/.trusthire/data
TRUSTHIRE_LLM_PROVIDER=anthropic      # anthropic | ollama | none (template)
# ANTHROPIC_API_KEY=sk-ant-...        # or use `ant auth login`
TRUSTHIRE_USE_CELERY=false            # true when Redis is available (docker compose sets it)
# TRUSTHIRE_REDIS_URL=redis://localhost:6379/0
