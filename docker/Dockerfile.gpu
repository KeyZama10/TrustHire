# GPU inference image: CUDA 12 + cuDNN, onnxruntime-gpu (CUDA/TensorRT EPs), CUDA torch, fp16.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv TRUSTHIRE_PROFILE=gpu \
    TRUSTHIRE_MODELS_DIR=/models TRUSTHIRE_DATA_DIR=/data HF_HOME=/models/hf DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3.12 python3.12-venv ffmpeg libgl1 \
    libglib2.0-0 curl && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY configs ./configs
# Linux resolves torch from PyPI (CUDA wheels); swap CPU onnxruntime for the GPU build.
RUN uv sync --frozen --no-dev --python python3.12 \
    && uv pip install --python /opt/venv/bin/python --no-deps "onnxruntime-gpu>=1.22" \
    && uv pip uninstall --python /opt/venv/bin/python onnxruntime || true
ENV PATH=/opt/venv/bin:$PATH
EXPOSE 8000
CMD ["sh", "-c", "trusthire download-models --profile gpu && trusthire serve --host 0.0.0.0 --port 8000"]
